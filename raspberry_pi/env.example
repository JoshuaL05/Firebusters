# Twilio details for the phone alert (alerts.py).
# Copy this file to .env in the same folder and fill it in. Never commit .env.
# Phone numbers in +1... format.
#Be sure that your actual env file is in the .gitignore, NEVER PUBLISH SECRETS TO MAIN.
#There are plenty of bots that scour github for leaked secrets and will then spend all of your usage
# If that happens,be sure to rotate your key, update your .gitignore to actually include the correct 
path to the .env file (eg: raspberry_pi/.env)
#The only good leaked key is a dead leaked key.

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=YOUR_AUTH_TOKEN_HERE
# Your Twilio number (Twilio console > Phone Numbers > Active numbers).
# Can be left empty on a trial account - Twilio then uses your trial number.
TWILIO_FROM=
ALERT_TO=+1XXXXXXXXXX
